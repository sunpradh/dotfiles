[
    {
        "name": "bottom-bar",
        "layer": "top",
        "position": "bottom",
        "height": 29,
        "modules-left": [
            "cpu",
            "memory",
            "temperature"
        ],
        "modules-center": [
            "clock#date",
            "clock#time"
        ],
        "modules-right":  [
            "mpris",
            "battery#bat0",
            "pulseaudio",
            "bluetooth",
            "sway/language",
            "tray",
            "idle_inhibitor"
        ],
        "sway/language": {
            "format":   "<span color='#A0A0A0'>KBD</span> <span text_transform='uppercase'><b>{shortDescription}</b></span>",
            "tooltip-format": "Keyboard layout: {long}"
        },
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
                "activated": "",
                "deactivated": ""
            }
        },
        "cpu": {
            "interval": 5,
            "format": "<span color='#A0A0A0'>CPU</span> <b>{usage}</b>"
        },
        "memory": {
            "interval": 10,
            "format": "<span color='#A0A0A0'>MEM</span> <b>{percentage}</b>"
        },
        "temperature": {
            "interval": 10,
            "format": "<span color='#A0A0A0'>TEMP</span> <b>{temperatureC}</b>"
        },
        "mpris": {
            "format": "{status_icon}  <span text_transform='uppercase'>{title}</span>",
            "status-icons": {
                "playing": "",
                "paused":  "",
                "stopped": "",
            },
            "tooltip": true,
            "tooltip-format": "[{player}] {dynamic}",
            "dynamic-len": 60,
            "title-len": 50
        },
        "tray": {
            "icon-size": 24,
            "spacing": 6
        },
        "clock#time": {
            "interval":     1,
            "format":       "<b>{:%H:%M}</b>",
            "tooltip":      false,
            "format-alt":   "<b>{:%H:%M:%S}</b>"
        },
        "clock#date": {
            "interval":       10,
            "format":         "<span text_transform='uppercase'>{:%a %d %b}</span>",
            "tooltip-format": "<tt>{calendar}</tt>",
            "format-alt":     "<span text_transform='uppercase'>{:%A %d %B %Y}</span>",
            "calendar": {
                "mode"          : "month",
                "on-scroll"     : -1,
                "on-click-right": "mode",
                "format": {
                    "months":     "<big>{}</big>",
                    "days":       "{}",
                    "weekdays":   "<b>{}</b>",
                    "today":      "<span color='#d02020'><b>{}</b></span>"
                }
            },
            "actions": {
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down"
            }
        },
        "battery#bat0": {
            "bat":             "BAT0",
            "states":          { "warning": 30, "critical": 15 },
            "format":          "<span color='#A0A0A0'>BAT</span> <b>{capacity}</b>",
            "format-charging": "<span color='#A0A0A0'>CHR</span> <b>{capacity}</b>",
            "format-plugged":  "",
            "format-alt":      "{icon} {time}",
            "format-full":     "",
            "format-icons":    ["", "", "", "", ""]
        },
        "pulseaudio": {
            "scroll-step":            1,
            "format":                 "<span color='#A0A0A0'>VOL</span> <b>{volume}</b>",
            "format-bluetooth":       "<span color='#A0A0A0'>VOL BT</span> <b>{volume}</b>",
            "format-bluetooth-muted": "<span color='#A0A0A0'>MUTE BT</span>",
            "format-muted":           "<span color='#A0A0A0'>MUTE</span>",
            "format-source":          "",
            "format-source-muted":    "",
            "on-click":               "footclient --app-id=pamixer --title='Volume Mixer' -W 90x24  ncpamixer",
            "on-click-right":         "set-volume toggle"
        },
        "bluetooth": {
            "format-disabled":  "<span color='#A0A0A0'>BT OFF</span>",
            "format-off":       "<span color='#A0A0A0'>BT</span> <b>OFF</b>",
            "format-on":        "<span color='#A0A0A0'>BT</span> <b>ON</b>",
            "format-connected": "<span color='#A0A0A0'>BT</span> <b>CON</b>",
            "on-click":         "footclient --app-id=bluetui --title=Bluetooth -W 80x24 bluetui",
            "on-click-right":   "toggle-bluetooth",
            "tooltip":          true,
            "tooltip-format":   "Bluetooth status: {status}",
            "tooltip-format-connected":   "Connected devices: {num_connections}\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}"
        }
    },
    {
        "name": "top-bar",
        "layer": "top",
        "position": "top",
        "height": 29,
        "modules-left": [
            "sway/workspaces"
        ],
        "modules-center": [
            "sway/window"
        ],
        "modules-right": [
            "sway/scratchpad"
        ],
        "sway/window": {
            "justify": "center",
            "on-click-middle": "swaymsg kill",
            "tooltip": true,
        },
        "sway/workspaces": {
            "disable-scroll": false,
            "all-outputs": false,
            "format": " <b>{name}</b> "
        },
        "sway/scratchpad": {
            "format": "<span color='#A0A0A0'>SCRPD</span>  <b>{count}</b>",
            "tooltip-format": "{title}"
        }
    }
]
// vim: ft=jsonc
