* {
    bg:        #303030;
    fg:        #a0a0a0;
    selectbg:  #802020;
    selectfg:  #d0d0d0;

    background-color: transparent;
    text-color:       @fg;

    font: "Iosevka Nerd Font 12";
    padding: 2px 0px;
}

window {
    location: center;
    background-color: @bg;
    /* y-offset: 5px; */
    width: 50%;
    children: [ mainbox,message ];
    padding: 10px;
    border: 1px;
    border-color: #d02020;
    border-radius: 0px;
}

mainbox {
    orientation: vertical;
    children: [ inputbar,listview ];
}

inputbar {
    spacing: 10px;
    padding: 0px 8px;
    width: 20%;
    children: [ prompt,entry ];
}

listview {
    layout: vertical;
}

prompt, entry, element-text {
    padding: 4px 4px;
    vertical-align: 0.5;
}

element {
    vertical-align: 0.5;
    spacing: 4px;
    padding: 4px 10px;
    margin: 0px 10px;
    childer: [ element-text ];
}

element.selected {
    background-color: @selectbg;
    border-radius: 0px;
    border: 1px;
    border-color: #d02020;
}

element-text.selected {
    background-color: transparent;
    text-color: @selectfg;
}

