#!/bin/sh
# Convert .flac file to .opus
# To be used inside Nicotine+ (Soulseek client)

FILE="$1"
if [[ ${FILE} != *".flac" ]]; then
    # notify-send "Not a .flac file" "${FILE}"
    exit 1
fi

NEWFILE="${FILE%flac}opus"

ffmpeg -i "${FILE}" -c:a libopus -b:a 160K "${NEWFILE}"

EXITCODE=$?

if [[ $EXITCODE == 0 ]]; then
    # notify-send "Converted successfully" "${FILE}"
    rm "${FILE}"
else
    notify-send "Error occured while converting flac -> opus" "${FILE}"
fi
