# Annoying popups
for_window [title=".*Indicatore condivisione"]     floating enable
for_window [title=".*Indicatore condivisione"]     move scratchpad
for_window [title=".*Sharing Indicator"]           floating enable
for_window [title=".*Sharing Indicator"]           move scratchpad
for_window [title=".*condividendo il tuo schermo"] floating enable
for_window [title=".*condividendo il tuo schermo"] move scratchpad

# Picture in picture
for_window [title="^Picture-in-Picture$"] {
    floating enable
    resize set height 25ppt
    resize set width  25ppt
    move position 73ppt 73ppt
    border pixel 1
    sticky toggle
}

# Specific workspaces
assign [app_id="firefox"]     $ws1
assign [app_id="thunderbird"] $ws5
assign [app_id="ferdium"]     $ws6

for_window [class="Joplin"] move to scratchpad

# inhibit idle for windows in fullscreen
for_window [class=".*"] inhibit_idle fullscreen

# Remove border from evince notes window
for_window [app_id="org.gnome.Evince" title="Unknown"]  border pixel 1

# Remove titlebar for some window
for_window [app_id="ferdium"]     border pixel $border_width

