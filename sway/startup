##
## Startup applications
##

# Load Xresources
exec_always xrdb -merge /home/sunny/.Xresources

# Display auto suspend
exec swayidle -w

# terminal server
exec foot --server --log-no-syslog

# network manager
exec nm-applet --indicator

# import the environment for systemd, fixes problems with xdg-desktop-portal
exec "systemctl --user import-environment"

# overlay for volume/brightness
exec start-wob

# Polkit agent
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Dropbox
# exec dropbox

# wlsunset
exec "wlsunset -l 43.15 -L -2.55 -t 4500" # Bilbao

# mako notification daemon
# activated via systemd

# Firefox
exec firefox

# Thunderbird
exec thunderbird

# Joplin
exec joplin
