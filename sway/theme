##
## Theme configuration
##

# Font
font pango:Inter SemiBold 16px

# Window borders settings
set $border_width 1
default_border normal $border_width
titlebar_border_thickness $border_width
title_align left
titlebar_padding 10 6

# Gaps
gaps              inner 5
smart_gaps        on
# smart_borders     off
hide_edge_borders smart

# No focus following mouse
focus_follows_mouse no

# Colors
set $bg        #242424
set $fg        #d0d0d0
set $red       #d02020
set $lightred  #C62020
set $darkred   #802020
set $brightred #ff0000
set $gray      #282828
set $lightgray #a0a0a0

# Color entry order
# 1: class name
# 2: titlebar border color
# 3: titlebar background color
# 4: titlebar text color
# 5: indicator (where new windows are open)
# 6: all-around window border color

# #1                    #2         #3         #4         #5         #6
client.focused          $red       $darkred   $fg        $brightred $red
client.focused_inactive $bg        $bg        $fg        $lightred  $bg
client.unfocused        $bg        $bg        $lightgray $lightgray $bg
client.urgent           $brightred $brightred $bg        $brightred $bg

## GTK settings
## Use nwg-look

# Wallpaper
output "*" bg ~/.wallpaper fill
# output "*" bg #7C98B3 solid_color

# Use waybar instead of swaybar
bar {
    swaybar_command waybar
}

